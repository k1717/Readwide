<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/theme_editor_root"
    android:background="?attr/colorSurface"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/theme_editor_appbar"
        android:background="?attr/colorPrimary"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary" app:titleTextColor="?attr/colorOnPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView android:id="@+id/theme_editor_scroll" android:background="?attr/colorSurface" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <EditText android:id="@+id/theme_name_input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/theme_editor_name_hint" android:layout_marginBottom="16dp" />

            <!-- Preview -->
            <TextView android:id="@+id/preview_text"
                android:layout_width="match_parent" android:layout_height="120dp"
                android:padding="16dp" android:textSize="16sp"
                android:text="@string/theme_editor_preview_text"
                android:layout_marginBottom="16dp" />

            <!-- Background color -->
            <TextView android:text="@string/theme_editor_background_color" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:layout_marginBottom="4dp" />
            <View android:id="@+id/bg_color_preview"
                android:layout_width="match_parent" android:layout_height="24dp"
                android:layout_marginBottom="4dp" />
            <EditText android:id="@+id/bg_hex_input"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:hint="@string/reading_background_hex"
                android:inputType="textNoSuggestions"
                android:digits="#0123456789abcdefABCDEF"
                android:maxLength="7"
                android:maxLines="1" android:singleLine="true"
                android:layout_marginBottom="6dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_bg_palette"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/choose_from_palette"
                android:textAllCaps="false"
                android:layout_marginBottom="6dp" />
            <TextView android:text="R" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
            <SeekBar android:id="@+id/bg_red" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" />
            <TextView android:text="G" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
            <SeekBar android:id="@+id/bg_green" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" />
            <TextView android:text="B" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
            <SeekBar android:id="@+id/bg_blue" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255"
                android:layout_marginBottom="16dp" />

            <!-- Toolbar background color -->
            <TextView android:text="@string/theme_editor_toolbar_background_color" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:layout_marginBottom="4dp" />
            <View android:id="@+id/toolbar_color_preview"
                android:layout_width="match_parent" android:layout_height="24dp"
                android:layout_marginBottom="4dp" />
            <EditText android:id="@+id/toolbar_hex_input"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:hint="@string/reading_toolbar_hex"
                android:inputType="textNoSuggestions"
                android:digits="#0123456789abcdefABCDEF"
                android:maxLength="7"
                android:maxLines="1" android:singleLine="true"
                android:layout_marginBottom="6dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_toolbar_palette"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/choose_from_palette"
                android:textAllCaps="false"
                android:layout_marginBottom="6dp" />
            <TextView android:text="R" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
            <SeekBar android:id="@+id/toolbar_red" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" />
            <TextView android:text="G" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
            <SeekBar android:id="@+id/toolbar_green" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" />
            <TextView android:text="B" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
            <SeekBar android:id="@+id/toolbar_blue" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255"
                android:layout_marginBottom="16dp" />

            <!-- Text color -->
            <TextView android:text="@string/theme_editor_text_color" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:layout_marginBottom="4dp" />
            <View android:id="@+id/text_color_preview"
                android:layout_width="match_parent" android:layout_height="24dp"
                android:layout_marginBottom="4dp" />
            <EditText android:id="@+id/text_hex_input"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:hint="@string/reading_text_hex"
                android:inputType="textNoSuggestions"
                android:digits="#0123456789abcdefABCDEF"
                android:maxLength="7"
                android:maxLines="1" android:singleLine="true"
                android:layout_marginBottom="6dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_text_palette"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/choose_from_palette"
                android:textAllCaps="false"
                android:layout_marginBottom="6dp" />
            <TextView android:text="R" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
            <SeekBar android:id="@+id/txt_red" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" />
            <TextView android:text="G" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
            <SeekBar android:id="@+id/txt_green" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" />
            <TextView android:text="B" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" />
            <SeekBar android:id="@+id/txt_blue" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255"
                android:layout_marginBottom="16dp" />

            <!-- Background image -->
            <TextView android:text="@string/theme_editor_background_image_optional" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:layout_marginBottom="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="24dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_pick_bg_image"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/theme_editor_choose_image" android:layout_marginEnd="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_clear_bg_image"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/theme_editor_clear_image" android:layout_marginStart="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_save_theme"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/theme_editor_save_theme" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
