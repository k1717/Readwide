<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/document_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:id="@+id/document_content_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#121212">

        <com.readwide.manager.ui.PageCounterTextView
            android:id="@+id/document_top_page_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121212"
            android:gravity="center"
            android:minHeight="32dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/document_viewport"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#121212">
            <LinearLayout
                android:id="@+id/document_spread_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:background="#121212"
                android:orientation="horizontal">

                <WebView
                    android:id="@+id/document_webview"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#121212"
                    android:scrollbars="none" />

                <WebView
                    android:id="@+id/document_webview_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#121212"
                    android:scrollbars="none"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/document_fast_scroll_rail"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@android:color/transparent"
                android:clickable="false"
                android:focusable="false"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <View
                    android:id="@+id/document_fast_scroll_thumb"
                    android:layout_width="8dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/fastscroll_thumb" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/loading_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:minWidth="110dp"
                android:minHeight="112dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/loading_progress"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/transparent"
                    android:textColor="#E0E0E0"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/document_search_overlay_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@android:color/transparent"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:id="@+id/document_nav_bar_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#121212"
            android:importantForAccessibility="no" />
    </LinearLayout>


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/document_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#000000"
        android:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#000000"
            app:navigationIconTint="@android:color/white"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/document_search_panel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#121212"
        android:elevation="11dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/document_bottom_scroller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#DD000000"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/document_page_status"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:translationY="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:textStyle="bold" />
        <SeekBar
            android:id="@+id/document_page_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:splitTrack="false"
            android:progressBackgroundTint="#555555"
            android:progressTint="#9E9E9E"
            android:thumbTint="#D6D6D6" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:id="@+id/document_toolbar_action_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/document_bottom_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/btn_prev_page"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_arrow_left"
                        android:text="@string/previous_page" />
                    <TextView
                        android:id="@+id/btn_next_page"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_arrow_right"
                        android:text="@string/next_page" />
                    <TextView
                        android:id="@+id/btn_document_search"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_search"
                        android:text="@string/find" />
                    <TextView
                        android:id="@+id/btn_page_move"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_page"
                        android:text="@string/bottom_page" />
                    <TextView
                        android:id="@+id/btn_bookmarks"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_bookmark"
                        android:text="@string/bookmark" />
                    <TextView
                        android:id="@+id/btn_document_tts"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:visibility="gone"
                        android:drawableTop="@drawable/ic_bottom_tts"
                        android:text="@string/tts_toolbar" />
                    <TextView
                        android:id="@+id/btn_screen_rotation"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_screen_rotation"
                        android:text="@string/screen_orientation_rotate" />
                    <TextView
                        android:id="@+id/btn_document_settings"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_settings"
                        android:text="@string/settings" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/btn_more"
                style="@style/ReaderBottomButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_bottom_more_horiz"
                android:text="@string/more" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/tts_floating_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="16dp"
        android:visibility="gone"
        android:background="@drawable/tts_floating_card_bg">

        <ImageButton
            android:id="@+id/tts_floating_play_pause"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/tts_pause"
            android:src="@android:drawable/ic_media_pause" />

        <ImageButton
            android:id="@+id/tts_floating_stop"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/tts_stop"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />

    </LinearLayout>

    <!--
      Android 15+ can keep system bars transparent even when a Window color is
      requested. These EPUB-only, non-interactive scrims are sized to the stable
      system insets so the bars always continue the reader body color rather
      than the overlay toolbar color.
    -->
    <View
        android:id="@+id/document_system_bar_scrim_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="#121212"
        android:clickable="false"
        android:elevation="40dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/document_system_bar_scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="#121212"
        android:clickable="false"
        android:elevation="40dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/document_system_bar_scrim_start"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#121212"
        android:clickable="false"
        android:elevation="40dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/document_system_bar_scrim_end"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#121212"
        android:clickable="false"
        android:elevation="40dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

</FrameLayout>
