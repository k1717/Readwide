<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pdf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:id="@+id/pdf_content_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/pdf_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#000000"
            app:titleTextColor="#FFFFFFFF" />

        <com.readwide.manager.ui.PageCounterTextView
            android:id="@+id/pdf_top_page_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121212"
            android:gravity="center"
            android:minHeight="32dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/pdf_viewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#121212">

        <HorizontalScrollView
            android:id="@+id/pdf_h_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <ScrollView
                android:id="@+id/pdf_v_scroll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <ImageView
                    android:id="@+id/pdf_page_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|top"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/pdf_page"
                    android:padding="0dp" />

            </ScrollView>
        </HorizontalScrollView>

        <com.readwide.manager.PdfPageView
            android:id="@+id/pdf_page_matrix_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pdf_continuous_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pdf_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:indeterminate="true" />

    </FrameLayout>

    <View
        android:id="@+id/pdf_nav_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#121212"
        android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/pdf_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/reader_bottom_chrome_rounded_default"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/pdf_page_status"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:translationY="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/pdf_page_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:splitTrack="false"
            android:progressBackgroundTint="#555555"
            android:progressTint="#9E9E9E"
            android:thumbTint="#D6D6D6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:id="@+id/pdf_toolbar_action_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/pdf_bottom_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pdf_prev"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_arrow_left"
                        android:text="@string/previous_page" />

                    <TextView
                        android:id="@+id/pdf_next"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_arrow_right"
                        android:text="@string/next_page" />

                    <TextView
                        android:id="@+id/pdf_find"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_search"
                        android:text="@string/find" />

                    <TextView
                        android:id="@+id/pdf_slide_toggle"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:text="" />

                    <TextView
                        android:id="@+id/pdf_page"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_page"
                        android:text="@string/bottom_page" />

                    <TextView
                        android:id="@+id/pdf_bookmark"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_bookmark"
                        android:text="@string/bookmark" />

                    <TextView
                        android:id="@+id/pdf_tts"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:visibility="gone"
                        android:drawableTop="@drawable/ic_bottom_tts"
                        android:text="@string/tts_toolbar" />

                    <TextView
                        android:id="@+id/pdf_screen_rotation"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_screen_rotation"
                        android:text="@string/screen_orientation_rotate" />

                    <TextView
                        android:id="@+id/pdf_settings"
                        style="@style/ReaderBottomButton"
                        android:layout_width="62dp"
                        android:layout_weight="0"
                        android:drawableTop="@drawable/ic_bottom_settings"
                        android:text="@string/settings" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/pdf_zoom_more"
                style="@style/ReaderBottomButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_bottom_more_horiz"
                android:text="@string/more" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
