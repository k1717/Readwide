# Gradle / Android Studio
.gradle/
build/
app/build/
*/build/
# libarchive uses this upstream "build" directory for checked-in CMake source
# modules and config.h.in. It is source input, not generated build output.
!third_party/libarchive-android/library/src/main/jni/external/libarchive/build/
!third_party/libarchive-android/library/src/main/jni/external/libarchive/build/cmake/
!third_party/libarchive-android/library/src/main/jni/external/libarchive/build/cmake/**
.cxx/
.externalNativeBuild/
.kotlin/
local.properties
.idea/
*.iml
captures/
.captures/

# Android build artifacts
*.apk
*.apks
*.aab
*.dex
*.ap_
*.class

# Signing keys / private certificates
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.der
keystore.properties

# Local secrets / service configs
.env
.env.*
secrets.properties
google-services.json
GoogleService-Info.plist

# Logs, heap dumps, profiler captures
*.log
*.hprof
captures/

# TextView exported user backups
textview_backup_*.json
TextView_backup_*.json

# Readwide exported user backups
readwide_backup_*.json
Readwide_backup_*.json

# OS files
.DS_Store
Thumbs.db
# Temporary patch / scratch files
search_ui.txt
search_func.txt
search_funcs.txt
*.bak
*.tmp
*.swp
*.orig
